{
  "name": "ai-wire",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "npm run db:migrate && NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "seed": "tsx scripts/seed.ts",
    "newsletter:draft": "tsx scripts/newsletter-draft.ts",
    "newsletter:publish": "tsx scripts/newsletter-publish.ts",
    "metrics": "npm run db:migrate && tsx scripts/metrics.ts"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.4.1",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.3",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "railway": "^3.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4"
  }
}
