# Postgres connection. On Railway, reference the Postgres service DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/railway

# Bearer token for POST /api/ingest/* and GET /api/metrics. Generate with: openssl rand -hex 32
AI_WIRE_INGEST_TOKEN=change-me

# Public origin, no trailing slash. RSS, sitemap, canonical links, and the metrics health check.
SITE_URL=http://localhost:3000

# Optional. ClawBytes section on Sovereign Signal. Header, subscribe links, and /issues redirects.
# Defaults to https://sovereignsignal.substack.com/s/clawbytes
# SUBSTACK_DIGEST_URL=https://sovereignsignal.substack.com/s/clawbytes

# Set to 1 to show seed rows in production. Hidden in production otherwise.
# SEED=1

# Unused. The digest is published on Substack. The draft command no longer calls a model.
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=
# OLLAMA_MODEL=kimi-k3
# OLLAMA_FALLBACK_MODELS=glm-5.3,deepseek-v4.1-flash

# Metrics cron. Leave the webhook unset until you want a POST when a check fails.
# HEALTH_ALERT_WEBHOOK_URL=
# HEALTH_STALE_HOURS_CLAWBYTES=18
# HEALTH_STALE_HOURS_MODELBYTES=36
# HEALTH_STALE_HOURS_INTERESTING_REPOS=18
# HEALTH_STALE_HOURS_RELEASE_BOT=168
